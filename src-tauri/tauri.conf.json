{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Aivora",
  "version": "0.1.8",
  "identifier": "com.devnamdev.aivora",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Aivora",
        "width": 120,
        "height": 120,
        "minWidth": 120,
        "minHeight": 120,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "resizable": true,
        "center": true,
        "skipTaskbar": false,
        "shadow": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["aivora"]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEU4RkM5OEQ0MDlBQTZDMjMKUldRamJLb0oxSmo4NkdiSUE1MS9WdWFvRHJUbFBmemZERDYxODQrUERjckhjaERWeW54djkwRjMK",
      "endpoints": [
        "https://github.com/devnamdev2003/ai-desktop-assistant/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
