# Aivora Assistant API - Environment Template
# Copy this file to .env and fill in your actual credentials.
# NEVER commit .env to public version control!

# Application
PROJECT_NAME="Aivora Assistant API"
ENVIRONMENT=development
FASTAPI_PORT=8000
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,tauri://localhost

# Database (PostgreSQL)
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/aivora

# JWT Authentication
# Generate a secure key with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Google OAuth 2.0 (Optional, for Google Sign-In)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# Gemini AI (Required for assistant chat generation)
GEMINI_API_KEY=
