{
  "name": "frontend",
  "version": "0.0.0",
  "scripts": {
    "dev": "ng serve --host 0.0.0.0 --port 3000 --proxy-config proxy.conf.json",
    "dev:all": "node scripts/dev-all.cjs",
    "auth:server": "python3 backend/run.py",
    "lint": "echo 'No lint errors'",
    "ng": "ng",
    "tauri": "tauri",
    "backend:dev": "python3 backend/run.py",
    "db:migrate": "node scripts/setup-db.cjs",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [{
      "files": "*.html",
      "options": {
        "parser": "angular"
      }
    }]
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^21.1.0",
    "@angular/compiler": "^21.1.0",
    "@angular/core": "^21.1.0",
    "@angular/forms": "^21.1.0",
    "@angular/platform-browser": "^21.1.0",
    "@angular/router": "^21.1.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-deep-link": "^2.4.10",
    "@tauri-apps/plugin-http": "^2.6.1",
    "@tauri-apps/plugin-opener": "^2.5.5",
    "@tauri-apps/plugin-updater": "^2.11.0",
    "marked": "^18.0.13",
    "postcss": "^8.5.28",
    "rxjs": "~7.8.0",
    "tailwindcss": "^4.3.3",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.1.2",
    "@angular/cli": "^21.1.2",
    "@angular/compiler-cli": "^21.1.0",
    "@tauri-apps/cli": "^2.11.4",
    "jsdom": "^27.1.0",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
}