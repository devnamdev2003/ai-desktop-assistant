# Application
PROJECT_NAME=Aivora Assistant API
ENVIRONMENT=development
FASTAPI_PORT=8000
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=*
# Frontend API Base URL (empty for relative /api/v1 proxying, or e.g. http://localhost:8000)
API_URL=

# Database (PostgreSQL)
DATABASE_URL=

# JWT Authentication
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Google OAuth 2.0
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# Gemini AI
GEMINI_API_KEY=
